<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8" />
    <title>Pythias Internal Server</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <script src="https://unpkg.com/react@18.2.0/umd/react.production.min.js" crossorigin></script>
    <script src="https://unpkg.com/react-dom@18.2.0/umd/react-dom.production.min.js" crossorigin></script>
    <script src="https://unpkg.com/@emotion/react@11.11.4/dist/emotion-react.umd.min.js" crossorigin></script>
    <script src="https://unpkg.com/@emotion/styled@11.11.0/dist/emotion-styled.umd.min.js" crossorigin></script>
    <script src="https://unpkg.com/@mui/material@5.15.12/umd/material-ui.production.min.js" crossorigin></script>
    <script src="https://unpkg.com/@babel/standalone@7.23.10/babel.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/axios@1.7.9/dist/axios.min.js"></script>
    <style>
      * { box-sizing: border-box; }
      body { margin: 0; background: #0d0d0d; overflow: hidden; }
      @keyframes spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
    </style>
  </head>
  <body>
    <script>
      window._initialOutput = <%- JSON.stringify(output || []) %>;
    </script>
    <%- include('partials/menu.ejs') %>
    <div id="root"></div>
    <script type="text/babel">
      const {
        ThemeProvider, createTheme, Box, Typography, Card, CardContent,
        Chip, Divider, CssBaseline, Tooltip, IconButton, Button,
      } = MaterialUI;
      const { useState, useEffect, useRef } = React;

      const theme = createTheme({
        palette: {
          mode: 'dark',
          primary: { main: '#fedd94', contrastText: '#1a1a1a' },
          background: { default: '#0d0d0d', paper: '#1a1a1a' },
        },
        typography: { fontFamily: '"Roboto", sans-serif' },
        shape: { borderRadius: 10 },
      });

      function formatTime(ts) {
        const d = new Date(ts);
        return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) +
          ' ' + d.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
      }

      function classifyEntry(output) {
        const lower = output.toLowerCase();
        if (lower.startsWith('error') || lower.startsWith('bad key') || lower.includes('could not reach') || lower.includes('failed'))
          return 'error';
        if (lower.startsWith('warn') || lower.includes('invalid'))
          return 'warn';
        return 'normal';
      }

      const ENTRY_STYLES = {
        error: {
          bg: 'rgba(244,67,54,0.07)',
          border: '1px solid rgba(244,67,54,0.25)',
          borderLeft: '3px solid #f44336',
          textColor: '#ff8a80',
          tsColor: '#c62828',
          icon: 'fa-circle-exclamation',
          iconColor: '#f44336',
        },
        warn: {
          bg: 'rgba(255,152,0,0.07)',
          border: '1px solid rgba(255,152,0,0.2)',
          borderLeft: '3px solid #ff9800',
          textColor: '#ffcc80',
          tsColor: '#e65100',
          icon: 'fa-triangle-exclamation',
          iconColor: '#ff9800',
        },
        normal: {
          bg: 'transparent',
          border: 'none',
          borderLeft: '3px solid transparent',
          textColor: '#d4d4d4',
          tsColor: '#6a6a6a',
          icon: null,
          iconColor: null,
        },
      };

      function LogEntry({ entry }) {
        const kind = classifyEntry(entry.output);
        const s = ENTRY_STYLES[kind];
        return (
          <Box sx={{
            display: 'flex', alignItems: 'flex-start', gap: 1.5,
            py: 0.75, px: 1,
            mb: '2px',
            borderRadius: '4px',
            background: s.bg,
            border: s.border,
            borderLeft: s.borderLeft,
          }}>
            {s.icon && (
              <i className={`fa-solid ${s.icon}`} style={{ color: s.iconColor, fontSize: '0.75rem', marginTop: 3, flexShrink: 0 }} />
            )}
            <Typography variant="caption" sx={{ color: s.tsColor, fontFamily: 'monospace', whiteSpace: 'nowrap', pt: '1px', flexShrink: 0 }}>
              {formatTime(entry.time)}
            </Typography>
            <Typography variant="body2" sx={{ color: s.textColor, fontFamily: 'monospace', lineHeight: 1.6 }}>
              {entry.output}
            </Typography>
          </Box>
        );
      }

      const UPDATE_STATES = {
        checking:  { icon: 'fa-rotate',           color: '#888',    bg: 'rgba(255,255,255,0.04)', label: 'Checking for updates…',      action: null },
        available: { icon: 'fa-circle-down',       color: '#64b5f6', bg: 'rgba(100,181,246,0.08)', label: 'Downloading update…',         action: null },
        ready:     { icon: 'fa-circle-check',      color: '#fedd94', bg: 'rgba(254,221,148,0.10)', label: 'Update ready — restart to install', action: 'Restart Now' },
        error:     { icon: 'fa-circle-exclamation',color: '#ef5350', bg: 'rgba(239,83,80,0.08)',   label: 'Update check failed',         action: null },
        current:   null,
      };

      function UpdateBanner({ state, msg, onInstall }) {
        const cfg = UPDATE_STATES[state];
        if (!cfg) return null;
        return (
          <Box sx={{
            display: 'flex', alignItems: 'center', gap: 1.5,
            px: 2, py: 1, mb: 1.5, borderRadius: '8px',
            bgcolor: cfg.bg, border: `1px solid ${cfg.color}30`,
            flexShrink: 0,
          }}>
            <i
              className={`fa-solid ${cfg.icon}`}
              style={{
                color: cfg.color, fontSize: '0.85rem', flexShrink: 0,
                animation: state === 'checking' || state === 'available' ? 'spin 1.2s linear infinite' : 'none',
              }}
            />
            <Typography variant="caption" sx={{ color: cfg.color, flexGrow: 1, fontWeight: 500 }}>
              {state === 'error' && msg ? `${cfg.label}: ${msg}` : cfg.label}
            </Typography>
            {cfg.action && (
              <Button
                size="small"
                variant="contained"
                onClick={onInstall}
                sx={{ bgcolor: '#fedd94', color: '#1a1a1a', fontWeight: 700, py: 0.25, px: 1.5, minWidth: 0, fontSize: '0.75rem', '&:hover': { bgcolor: '#f5ca60' } }}
              >
                {cfg.action}
              </Button>
            )}
          </Box>
        );
      }

      function Dashboard() {
        const [logs, setLogs] = useState([...window._initialOutput]);
        const [live, setLive] = useState(true);
        const [updateState, setUpdateState] = useState(null);
        const [updateMsg, setUpdateMsg] = useState('');
        const bottomRef = useRef(null);

        useEffect(() => {
          const poll = setInterval(async () => {
            try {
              const { data } = await axios.get('/output');
              setLogs([...data]);
              setLive(true);
            } catch {
              setLive(false);
            }
          }, 1500);
          return () => clearInterval(poll);
        }, []);

        useEffect(() => {
          window.electronAPI?.onUpdateStatus?.(({ status, msg }) => {
            setUpdateState(status);
            setUpdateMsg(msg || '');
            // auto-clear transient states after a few seconds
            if (status === 'current' || status === 'error') {
              setTimeout(() => setUpdateState(null), status === 'current' ? 3000 : 8000);
            }
          });
        }, []);

        useEffect(() => {
          if (bottomRef.current) {
            bottomRef.current.scrollIntoView({ behavior: 'smooth' });
          }
        }, [logs]);

        return (
          <ThemeProvider theme={theme}>
            <CssBaseline />
            <Box sx={{ height: 'calc(100vh - 60px)', overflow: 'hidden', bgcolor: 'background.default', p: { xs: 2, md: 3 }, display: 'flex', flexDirection: 'column' }}>
              <Box sx={{ maxWidth: 900, mx: 'auto', width: '100%', flexGrow: 1, display: 'flex', flexDirection: 'column', overflow: 'hidden' }}>
                {/* Header */}
                <Box sx={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', mb: 3, flexShrink: 0 }}>
                  <Box sx={{ display: 'flex', alignItems: 'center', gap: 2 }}>
                    <img src="/logoPythias-400.png" alt="Pythias" height="48" />
                    <Box>
                      <Typography variant="h5" sx={{ color: '#fedd94', fontWeight: 700, lineHeight: 1.2 }}>
                        Internal Server
                      </Typography>
                      <Typography variant="caption" sx={{ color: '#6a6a6a' }}>
                        Activity Monitor
                      </Typography>
                    </Box>
                  </Box>
                  <Box sx={{ display: 'flex', alignItems: 'center', gap: 1.5 }}>
                    <Chip
                      icon={<span style={{ width: 8, height: 8, borderRadius: '50%', background: live ? '#4caf50' : '#f44336', display: 'inline-block', marginLeft: 8 }} />}
                      label={live ? 'Live' : 'Disconnected'}
                      size="small"
                      sx={{
                        bgcolor: live ? 'rgba(76,175,80,0.12)' : 'rgba(244,67,54,0.12)',
                        color: live ? '#4caf50' : '#f44336',
                        border: `1px solid ${live ? '#4caf50' : '#f44336'}`,
                        fontWeight: 600,
                      }}
                    />
                    <Tooltip title="Minimize to tray">
                      <IconButton
                        size="small"
                        onClick={() => window.electronAPI?.minimizeToTray()}
                        sx={{ color: '#555', border: '1px solid #2a2a2a', borderRadius: 1, '&:hover': { color: '#fedd94', borderColor: '#fedd94' } }}
                      >
                        <i className="fa-solid fa-window-minimize" style={{ fontSize: '0.8rem' }} />
                      </IconButton>
                    </Tooltip>
                  </Box>
                </Box>

                <UpdateBanner
                  state={updateState}
                  msg={updateMsg}
                  onInstall={() => window.electronAPI?.installUpdate()}
                />

                {/* Log Card */}
                <Card sx={{ bgcolor: '#141414', border: '1px solid #2a2a2a', flexGrow: 1, display: 'flex', flexDirection: 'column', overflow: 'hidden' }}>
                  <CardContent sx={{ p: 0, flexGrow: 1, display: 'flex', flexDirection: 'column', overflow: 'hidden', '&:last-child': { pb: 0 } }}>
                    <Box sx={{ px: 2.5, py: 1.5, borderBottom: '1px solid #2a2a2a', display: 'flex', alignItems: 'center', gap: 1 }}>
                      <i className="fa-solid fa-terminal" style={{ color: '#fedd94', fontSize: '0.85rem' }} />
                      <Typography variant="subtitle2" sx={{ color: '#aaa', letterSpacing: 1, textTransform: 'uppercase', fontSize: '0.7rem' }}>
                        Activity Log — {logs.length} entries
                      </Typography>
                    </Box>
                    <Box
                      sx={{
                        flexGrow: 1,
                        overflowY: 'auto',
                        px: 2.5,
                        py: 1,
                        '&::-webkit-scrollbar': { width: 6 },
                        '&::-webkit-scrollbar-track': { bgcolor: 'transparent' },
                        '&::-webkit-scrollbar-thumb': { bgcolor: '#3a3a3a', borderRadius: 3 },
                      }}
                    >
                      {logs.length === 0 ? (
                        <Typography variant="body2" sx={{ color: '#4a4a4a', textAlign: 'center', mt: 4, fontFamily: 'monospace' }}>
                          No activity yet...
                        </Typography>
                      ) : (
                        logs.map((entry, i) => <LogEntry key={`${i}-${entry.time}`} entry={entry} />)
                      )}
                      <div ref={bottomRef} />
                    </Box>
                  </CardContent>
                </Card>
              </Box>
            </Box>
          </ThemeProvider>
        );
      }

      ReactDOM.createRoot(document.getElementById('root')).render(<Dashboard />);
    </script>
  </body>
</html>
