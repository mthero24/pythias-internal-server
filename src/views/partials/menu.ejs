<script>
  window._navKey = <%- JSON.stringify(key || '') %>;
</script>
<div id="nav-root"></div>
<script type="text/babel">
  const { AppBar, Toolbar, Box, IconButton, Tooltip, ThemeProvider, createTheme } = MaterialUI;

  const navTheme = createTheme({
    palette: {
      mode: 'dark',
      primary: { main: '#fedd94', contrastText: '#1a1a1a' },
    },
    typography: { fontFamily: '"Roboto", sans-serif' },
  });

  function NavBar() {
    const key = window._navKey;
    return (
      <ThemeProvider theme={navTheme}>
        <AppBar position="fixed" elevation={0} sx={{ bgcolor: '#fedd94', borderBottom: '2px solid #e8c020' }}>
          <Toolbar sx={{ minHeight: 60 }}>
            <Box sx={{ flexGrow: 1, display: 'flex', alignItems: 'center' }}>
              <a href={key ? `/?key=${key}` : '/'} style={{ display: 'flex', alignItems: 'center' }}>
                <img src="/pythias-logo-new-black-100.png" alt="Pythias" height="34" style={{ display: 'block' }} />
              </a>
            </Box>
            <Box sx={{ display: 'flex', alignItems: 'center', gap: 0.5 }}>
              <Tooltip title="Setup Guide">
                <IconButton href={`/setup?key=${key}`} size="large" sx={{ color: '#1a1a1a' }}>
                  <i className="fa-solid fa-book-open" style={{ fontSize: '1.1rem' }} />
                </IconButton>
              </Tooltip>
              <Tooltip title="Settings">
                <IconButton href={`/settings?key=${key}`} size="large" sx={{ color: '#1a1a1a' }}>
                  <i className="fa-solid fa-gear" style={{ fontSize: '1.1rem' }} />
                </IconButton>
              </Tooltip>
              {key ? (
                <>
                  <Tooltip title="Account">
                    <IconButton href={`/account?key=${key}`} size="large" sx={{ color: '#1a1a1a' }}>
                      <i className="fa-solid fa-user" style={{ fontSize: '1.1rem' }} />
                    </IconButton>
                  </Tooltip>
                  <Tooltip title="Logout">
                    <IconButton href={`/logout?key=${key}`} size="large" sx={{ color: '#1a1a1a' }}>
                      <i className="fa-solid fa-right-from-bracket" style={{ fontSize: '1.1rem' }} />
                    </IconButton>
                  </Tooltip>
                </>
              ) : (
                <Tooltip title="Login">
                  <IconButton href="/login" size="large" sx={{ color: '#1a1a1a' }}>
                    <i className="fa-solid fa-user" style={{ fontSize: '1.1rem' }} />
                  </IconButton>
                </Tooltip>
              )}
            </Box>
          </Toolbar>
        </AppBar>
        <Toolbar sx={{ minHeight: 60 }} />
      </ThemeProvider>
    );
  }

  ReactDOM.createRoot(document.getElementById('nav-root')).render(<NavBar />);
</script>
