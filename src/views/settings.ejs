<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8" />
    <title>Pythias — Settings</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <script src="https://unpkg.com/react@18.2.0/umd/react.production.min.js" crossorigin></script>
    <script src="https://unpkg.com/react-dom@18.2.0/umd/react-dom.production.min.js" crossorigin></script>
    <script src="https://unpkg.com/@emotion/react@11.11.4/dist/emotion-react.umd.min.js" crossorigin></script>
    <script src="https://unpkg.com/@emotion/styled@11.11.0/dist/emotion-styled.umd.min.js" crossorigin></script>
    <script src="https://unpkg.com/@mui/material@5.15.12/umd/material-ui.production.min.js" crossorigin></script>
    <script src="https://unpkg.com/@babel/standalone@7.23.10/babel.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/axios@1.7.9/dist/axios.min.js"></script>
    <style>* { box-sizing: border-box; } body { margin: 0; background: #0d0d0d; }</style>
  </head>
  <body>
    <script>
      window._settings = <%- JSON.stringify(settings) %>;
      window._settingsKey = <%- JSON.stringify(key || '') %>;
    </script>
    <%- include('partials/menu.ejs') %>
    <div id="root"></div>
    <script type="text/babel">
      const {
        ThemeProvider, createTheme, CssBaseline, Box, Grid, Card, CardContent,
        CardHeader, Typography, TextField, Button, IconButton, Tooltip,
        Snackbar, Alert, Divider, Chip, CircularProgress,
      } = MaterialUI;
      const { useState, useCallback } = React;

      const theme = createTheme({
        palette: {
          mode: 'dark',
          primary: { main: '#fedd94', contrastText: '#1a1a1a' },
          background: { default: '#0d0d0d', paper: '#1a1a1a' },
        },
        typography: { fontFamily: '"Roboto", sans-serif' },
        shape: { borderRadius: 10 },
      });

      // Auto-generate the next key name for a section
      function nextKey(prefix, existingKeys) {
        const nums = existingKeys
          .filter(k => k.startsWith(prefix))
          .map(k => parseInt(k.slice(prefix.length)))
          .filter(n => !isNaN(n) && n > 0);
        return `${prefix}${nums.length === 0 ? 1 : Math.max(...nums) + 1}`;
      }

      // Get/set a nested value in the settings object by path array
      function getAtPath(obj, path) {
        return path.reduce((o, k) => (o && o[k] != null ? o[k] : {}), obj);
      }
      function setAtPath(obj, path, value) {
        const next = { ...obj };
        if (path.length === 1) {
          next[path[0]] = value;
        } else {
          next[path[0]] = setAtPath(obj[path[0]] || {}, path.slice(1), value);
        }
        return next;
      }

      const SECTIONS = [
        { title: 'Shipping Printers', icon: 'fa-truck', path: ['shipping', 'printers'], prefix: 'station', placeholder: 'IP address of the station PC (e.g. 192.168.1.10)' },
        { title: 'Shipping Scales',   icon: 'fa-weight-hanging', path: ['shipping', 'scales'],   prefix: 'station', placeholder: 'IP address' },
        { title: 'Embroidery',        icon: 'fa-scissors',     path: ['emb'],              prefix: 'head',    placeholder: 'IP address' },
        { title: 'DTF Printers',      icon: 'fa-print',        path: ['dtf'],              prefix: 'printer', placeholder: 'IP address' },
        { title: 'ROQ',               icon: 'fa-boxes-stacked',path: ['roq'],              prefix: 'printer', placeholder: 'IP address' },
        { title: 'Label Printers',    icon: 'fa-tag',          path: ['labelPrinters'],    prefix: 'printer', placeholder: 'IP address' },
        { title: 'Picklist Printers', icon: 'fa-list-ul',      path: ['picklistPrinters'], prefix: 'printer', placeholder: 'IP address of file-writer PC' },
        { title: 'Sublimation',       icon: 'fa-droplet',      path: ['sublimation'],      prefix: 'printer', placeholder: 'IP address' },
        { title: 'DTG Printers',      icon: 'fa-tshirt',       path: ['dtgPrinters'],      prefix: 'printer', placeholder: 'IP address' },
      ];

      function SettingSection({ section, entries, onAdd, onEdit, onDelete }) {
        const [newIp, setNewIp] = useState('');
        const [editKey, setEditKey] = useState(null);
        const [editVal, setEditVal] = useState('');

        const startEdit = (k, v) => { setEditKey(k); setEditVal(v); };
        const cancelEdit = () => { setEditKey(null); setEditVal(''); };

        const commitEdit = () => {
          if (!editVal.trim()) return;
          onEdit(editKey, editVal.trim());
          cancelEdit();
        };

        const handleAdd = () => {
          if (!newIp.trim()) return;
          onAdd(newIp.trim());
          setNewIp('');
        };

        const entryList = Object.entries(entries);

        return (
          <Card sx={{ bgcolor: '#1a1a1a', border: '1px solid #2a2a2a', height: '100%', display: 'flex', flexDirection: 'column' }}>
            <CardHeader
              avatar={<i className={`fa-solid ${section.icon}`} style={{ color: '#fedd94', fontSize: '1rem', width: 20, textAlign: 'center' }} />}
              title={<Typography variant="subtitle1" sx={{ fontWeight: 600, color: '#f0f0f0' }}>{section.title}</Typography>}
              sx={{ pb: 0, borderBottom: '1px solid #2a2a2a' }}
            />
            <CardContent sx={{ flexGrow: 1, display: 'flex', flexDirection: 'column', gap: 1, pt: 1.5 }}>
              {/* Entry list */}
              <Box sx={{ flexGrow: 1, minHeight: 40 }}>
                {entryList.length === 0 ? (
                  <Typography variant="caption" sx={{ color: '#444', display: 'block', textAlign: 'center', py: 1 }}>
                    No entries yet
                  </Typography>
                ) : entryList.map(([k, v]) => (
                  <Box key={k} sx={{ display: 'flex', alignItems: 'center', gap: 1, mb: 0.75 }}>
                    {editKey === k ? (
                      <>
                        <Chip label={k} size="small" sx={{ bgcolor: '#2a2a2a', color: '#fedd94', border: '1px solid #fedd9440', minWidth: 70 }} />
                        <TextField
                          size="small"
                          value={editVal}
                          onChange={(e) => setEditVal(e.target.value)}
                          onKeyDown={(e) => { if (e.key === 'Enter') commitEdit(); if (e.key === 'Escape') cancelEdit(); }}
                          autoFocus
                          sx={{ flexGrow: 1, '& .MuiOutlinedInput-root': { '&.Mui-focused fieldset': { borderColor: '#fedd94' } } }}
                        />
                        <Tooltip title="Save">
                          <IconButton size="small" onClick={commitEdit} sx={{ color: '#4caf50' }}>
                            <i className="fa-solid fa-check" style={{ fontSize: '0.85rem' }} />
                          </IconButton>
                        </Tooltip>
                        <Tooltip title="Cancel">
                          <IconButton size="small" onClick={cancelEdit} sx={{ color: '#666' }}>
                            <i className="fa-solid fa-xmark" style={{ fontSize: '0.85rem' }} />
                          </IconButton>
                        </Tooltip>
                      </>
                    ) : (
                      <>
                        <Chip label={k} size="small" sx={{ bgcolor: '#2a2a2a', color: '#fedd94', border: '1px solid #fedd9440', minWidth: 70 }} />
                        <Typography variant="body2" sx={{ color: '#ccc', flexGrow: 1, fontFamily: 'monospace' }}>{v}</Typography>
                        <Tooltip title="Edit">
                          <IconButton size="small" onClick={() => startEdit(k, v)} sx={{ color: '#666', '&:hover': { color: '#fedd94' } }}>
                            <i className="fa-solid fa-pen" style={{ fontSize: '0.8rem' }} />
                          </IconButton>
                        </Tooltip>
                        <Tooltip title="Delete">
                          <IconButton size="small" onClick={() => onDelete(k)} sx={{ color: '#666', '&:hover': { color: '#ef5350' } }}>
                            <i className="fa-solid fa-trash" style={{ fontSize: '0.8rem' }} />
                          </IconButton>
                        </Tooltip>
                      </>
                    )}
                  </Box>
                ))}
              </Box>

              <Divider sx={{ borderColor: '#2a2a2a' }} />

              {/* Add new */}
              <Box sx={{ display: 'flex', gap: 1, pt: 0.5 }}>
                <TextField
                  size="small"
                  placeholder={section.placeholder}
                  value={newIp}
                  onChange={(e) => setNewIp(e.target.value)}
                  onKeyDown={(e) => e.key === 'Enter' && handleAdd()}
                  fullWidth
                  sx={{ '& .MuiOutlinedInput-root': { '&.Mui-focused fieldset': { borderColor: '#fedd94' } } }}
                />
                <Button
                  variant="contained"
                  onClick={handleAdd}
                  sx={{ bgcolor: '#fedd94', color: '#1a1a1a', fontWeight: 700, whiteSpace: 'nowrap', '&:hover': { bgcolor: '#f5ca60' }, minWidth: 60 }}
                >
                  Add
                </Button>
              </Box>
            </CardContent>
          </Card>
        );
      }

      function DigitalLineSection({ values, onChange }) {
        const [host, setHost] = useState(values.host || '');
        const [port, setPort] = useState(values.port || '8001');

        const commit = () => onChange({ host: host.trim(), port: port.trim() });

        return (
          <Card sx={{ bgcolor: '#1a1a1a', border: '1px solid #2a2a2a', height: '100%', display: 'flex', flexDirection: 'column' }}>
            <CardHeader
              avatar={<i className="fa-solid fa-desktop" style={{ color: '#fedd94', fontSize: '1rem', width: 20, textAlign: 'center' }} />}
              title={<Typography variant="subtitle1" sx={{ fontWeight: 600, color: '#f0f0f0' }}>Digital Line</Typography>}
              sx={{ pb: 0, borderBottom: '1px solid #2a2a2a' }}
            />
            <CardContent sx={{ display: 'flex', flexDirection: 'column', gap: 1.5, pt: 1.5 }}>
              <TextField
                size="small"
                label="Host IP"
                placeholder="192.168.1.38"
                value={host}
                onChange={(e) => setHost(e.target.value)}
                onBlur={commit}
                onKeyDown={(e) => e.key === 'Enter' && commit()}
                fullWidth
                sx={{ '& .MuiOutlinedInput-root': { '&.Mui-focused fieldset': { borderColor: '#fedd94' } } }}
              />
              <TextField
                size="small"
                label="Port"
                placeholder="8001"
                value={port}
                onChange={(e) => setPort(e.target.value)}
                onBlur={commit}
                onKeyDown={(e) => e.key === 'Enter' && commit()}
                fullWidth
                sx={{ '& .MuiOutlinedInput-root': { '&.Mui-focused fieldset': { borderColor: '#fedd94' } } }}
              />
              <Typography variant="caption" sx={{ color: '#555' }}>
                Brown Mfg Digital Line — bulk items queued via AddToQueue at host:port
              </Typography>
            </CardContent>
          </Card>
        );
      }

      function SettingsPage() {
        const [settings, setSettings] = useState(window._settings);
        const [saving, setSaving] = useState(false);
        const [toast, setToast] = useState({ open: false, msg: '', severity: 'success' });

        const showToast = (msg, severity = 'success') => setToast({ open: true, msg, severity });

        const saveToServer = useCallback(async (newSettings) => {
          setSaving(true);
          try {
            const { data } = await axios.post('/update-settings', { settings: newSettings, key: window._settingsKey });
            if (data.error) {
              showToast(data.msg || 'Save failed', 'error');
              if (data.msg === 'invalid key') location.href = '/login';
            } else {
              showToast('Settings saved');
            }
          } catch {
            showToast('Could not reach server', 'error');
          } finally {
            setSaving(false);
          }
        }, []);

        const handleAdd = (section, ip) => {
          const current = getAtPath(settings, section.path);
          const key = nextKey(section.prefix, Object.keys(current));
          const updated = setAtPath(settings, section.path, { ...current, [key]: ip });
          setSettings(updated);
          saveToServer(updated);
        };

        const handleEdit = (section, entryKey, newIp) => {
          const current = getAtPath(settings, section.path);
          const updated = setAtPath(settings, section.path, { ...current, [entryKey]: newIp });
          setSettings(updated);
          saveToServer(updated);
        };

        const handleDelete = (section, entryKey) => {
          const current = { ...getAtPath(settings, section.path) };
          delete current[entryKey];
          const updated = setAtPath(settings, section.path, current);
          setSettings(updated);
          saveToServer(updated);
        };

        return (
          <ThemeProvider theme={theme}>
            <CssBaseline />
            <Box sx={{ minHeight: '100vh', bgcolor: 'background.default', p: { xs: 2, md: 3 } }}>
              {/* Page header */}
              <Box sx={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', mb: 3 }}>
                <Typography variant="h5" sx={{ color: '#f0f0f0', fontWeight: 700 }}>
                  Settings
                </Typography>
                {saving && (
                  <Box sx={{ display: 'flex', alignItems: 'center', gap: 1 }}>
                    <CircularProgress size={16} sx={{ color: '#fedd94' }} />
                    <Typography variant="caption" sx={{ color: '#fedd94' }}>Saving…</Typography>
                  </Box>
                )}
              </Box>

              <Grid container spacing={2.5}>
                {SECTIONS.map((section) => (
                  <Grid item xs={12} sm={6} lg={4} key={section.title}>
                    <SettingSection
                      section={section}
                      entries={getAtPath(settings, section.path)}
                      onAdd={(ip) => handleAdd(section, ip)}
                      onEdit={(k, v) => handleEdit(section, k, v)}
                      onDelete={(k) => handleDelete(section, k)}
                    />
                  </Grid>
                ))}
                <Grid item xs={12} sm={6} lg={4}>
                  <DigitalLineSection
                    values={settings.synergy || { host: 'localhost', port: '8001' }}
                    onChange={(val) => {
                      const updated = setAtPath(settings, ['synergy'], val);
                      setSettings(updated);
                      saveToServer(updated);
                    }}
                  />
                </Grid>
              </Grid>
            </Box>

            <Snackbar
              open={toast.open}
              autoHideDuration={3000}
              onClose={() => setToast(t => ({ ...t, open: false }))}
              anchorOrigin={{ vertical: 'bottom', horizontal: 'right' }}
            >
              <Alert
                severity={toast.severity}
                sx={{ bgcolor: toast.severity === 'success' ? 'rgba(76,175,80,0.15)' : 'rgba(211,47,47,0.15)', border: `1px solid ${toast.severity === 'success' ? '#4caf50' : '#f44336'}` }}
              >
                {toast.msg}
              </Alert>
            </Snackbar>
          </ThemeProvider>
        );
      }

      ReactDOM.createRoot(document.getElementById('root')).render(<SettingsPage />);
    </script>
  </body>
</html>
