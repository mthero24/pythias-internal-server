<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8" />
    <title>Pythias — Account</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <script src="https://unpkg.com/react@18.2.0/umd/react.production.min.js" crossorigin></script>
    <script src="https://unpkg.com/react-dom@18.2.0/umd/react-dom.production.min.js" crossorigin></script>
    <script src="https://unpkg.com/@emotion/react@11.11.4/dist/emotion-react.umd.min.js" crossorigin></script>
    <script src="https://unpkg.com/@emotion/styled@11.11.0/dist/emotion-styled.umd.min.js" crossorigin></script>
    <script src="https://unpkg.com/@mui/material@5.15.12/umd/material-ui.production.min.js" crossorigin></script>
    <script src="https://unpkg.com/@babel/standalone@7.23.10/babel.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/axios@1.7.9/dist/axios.min.js"></script>
    <style>* { box-sizing: border-box; } body { margin: 0; background: #0d0d0d; }</style>
  </head>
  <body>
    <script>
      window._accountKey = <%- JSON.stringify(key || '') %>;
      window._apiKey = <%- JSON.stringify(apiKey && apiKey.key ? apiKey.key : '') %>;
    </script>
    <%- include('partials/menu.ejs') %>
    <div id="root"></div>
    <script type="text/babel">
      const {
        ThemeProvider, createTheme, CssBaseline, Box, Card, CardContent,
        Typography, TextField, Button, IconButton, Tooltip, Snackbar, Alert,
        Divider, CircularProgress, Dialog, DialogTitle, DialogContent,
        DialogContentText, DialogActions,
      } = MaterialUI;
      const { useState } = React;

      const theme = createTheme({
        palette: {
          mode: 'dark',
          primary: { main: '#fedd94', contrastText: '#1a1a1a' },
          background: { default: '#0d0d0d', paper: '#1a1a1a' },
        },
        typography: { fontFamily: '"Roboto", sans-serif' },
        shape: { borderRadius: 10 },
      });

      function AccountPage() {
        const [apiKey, setApiKey] = useState(window._apiKey || '');
        const [loading, setLoading] = useState(false);
        const [copied, setCopied] = useState(false);
        const [confirmOpen, setConfirmOpen] = useState(false);
        const [toast, setToast] = useState({ open: false, msg: '', severity: 'success' });

        const showToast = (msg, severity = 'success') => setToast({ open: true, msg, severity });

        const generateKey = async () => {
          setConfirmOpen(false);
          setLoading(true);
          try {
            const { data } = await axios.post('/generate-api-key', { key: window._accountKey });
            if (data.error) {
              showToast(data.msg || 'Failed to generate key', 'error');
              if (data.msg === 'invalid key') location.href = '/login';
            } else {
              setApiKey(data.apiKey.key);
              showToast('New API key generated');
            }
          } catch {
            showToast('Could not connect to server', 'error');
          } finally {
            setLoading(false);
          }
        };

        const copyKey = async () => {
          if (!apiKey) return;
          try {
            await navigator.clipboard.writeText(apiKey);
            setCopied(true);
            setTimeout(() => setCopied(false), 2000);
          } catch {
            showToast('Could not copy — select and copy manually', 'warning');
          }
        };

        return (
          <ThemeProvider theme={theme}>
            <CssBaseline />
            <Box sx={{ minHeight: '100vh', bgcolor: 'background.default', p: { xs: 2, md: 4 }, display: 'flex', justifyContent: 'center' }}>
              <Box sx={{ width: '100%', maxWidth: 560 }}>
                <Typography variant="h5" sx={{ color: '#f0f0f0', fontWeight: 700, mb: 3 }}>
                  Account
                </Typography>

                {/* API Key card */}
                <Card sx={{ bgcolor: '#1a1a1a', border: '1px solid #2a2a2a' }}>
                  <CardContent sx={{ p: 3 }}>
                    <Box sx={{ display: 'flex', alignItems: 'center', gap: 1.5, mb: 1.5 }}>
                      <i className="fa-solid fa-key" style={{ color: '#fedd94', fontSize: '1rem' }} />
                      <Typography variant="subtitle1" sx={{ fontWeight: 600, color: '#f0f0f0' }}>
                        API Key
                      </Typography>
                    </Box>
                    <Typography variant="body2" sx={{ color: '#666', mb: 2 }}>
                      Use this key to authenticate requests from other services to this internal server.
                      Keep it secret — regenerating creates a new key and invalidates the old one.
                    </Typography>

                    <Divider sx={{ borderColor: '#2a2a2a', mb: 2 }} />

                    <Box sx={{ display: 'flex', gap: 1, alignItems: 'stretch' }}>
                      <TextField
                        value={apiKey || 'No key generated yet'}
                        variant="outlined"
                        fullWidth
                        size="small"
                        inputProps={{ readOnly: true, style: { fontFamily: 'monospace', fontSize: '0.82rem', color: apiKey ? '#a5d6a7' : '#555' } }}
                        sx={{
                          '& .MuiOutlinedInput-root': {
                            bgcolor: '#111',
                            '& fieldset': { borderColor: '#333' },
                          },
                        }}
                      />
                      <Tooltip title={copied ? 'Copied!' : 'Copy to clipboard'}>
                        <IconButton
                          onClick={copyKey}
                          disabled={!apiKey}
                          sx={{
                            border: '1px solid #333',
                            borderRadius: 1,
                            color: copied ? '#4caf50' : '#888',
                            '&:hover': { borderColor: '#fedd94', color: '#fedd94' },
                          }}
                        >
                          <i className={`fa-solid ${copied ? 'fa-check' : 'fa-copy'}`} style={{ fontSize: '0.9rem' }} />
                        </IconButton>
                      </Tooltip>
                    </Box>

                    <Button
                      variant="outlined"
                      onClick={() => setConfirmOpen(true)}
                      disabled={loading}
                      startIcon={loading
                        ? <CircularProgress size={16} sx={{ color: '#fedd94' }} />
                        : <i className="fa-solid fa-rotate" style={{ fontSize: '0.85rem' }} />
                      }
                      sx={{
                        mt: 2,
                        borderColor: '#fedd94',
                        color: '#fedd94',
                        fontWeight: 600,
                        '&:hover': { bgcolor: 'rgba(254,221,148,0.08)', borderColor: '#fedd94' },
                        '&:disabled': { borderColor: '#333', color: '#555' },
                      }}
                    >
                      {loading ? 'Generating…' : 'Generate New Key'}
                    </Button>
                  </CardContent>
                </Card>
              </Box>
            </Box>

            {/* Confirm dialog */}
            <Dialog
              open={confirmOpen}
              onClose={() => setConfirmOpen(false)}
              PaperProps={{ sx: { bgcolor: '#1a1a1a', border: '1px solid #2a2a2a', borderRadius: 2 } }}
            >
              <DialogTitle sx={{ color: '#f0f0f0' }}>Generate New API Key?</DialogTitle>
              <DialogContent>
                <DialogContentText sx={{ color: '#aaa' }}>
                  This will invalidate the current key. Any service using the old key will stop working until updated.
                </DialogContentText>
              </DialogContent>
              <DialogActions sx={{ pb: 2, pr: 2 }}>
                <Button onClick={() => setConfirmOpen(false)} sx={{ color: '#888' }}>
                  Cancel
                </Button>
                <Button
                  onClick={generateKey}
                  variant="contained"
                  sx={{ bgcolor: '#fedd94', color: '#1a1a1a', fontWeight: 700, '&:hover': { bgcolor: '#f5ca60' } }}
                >
                  Generate
                </Button>
              </DialogActions>
            </Dialog>

            <Snackbar
              open={toast.open}
              autoHideDuration={3000}
              onClose={() => setToast(t => ({ ...t, open: false }))}
              anchorOrigin={{ vertical: 'bottom', horizontal: 'right' }}
            >
              <Alert
                severity={toast.severity}
                sx={{ bgcolor: toast.severity === 'success' ? 'rgba(76,175,80,0.15)' : 'rgba(211,47,47,0.15)', border: `1px solid ${toast.severity === 'success' ? '#4caf50' : '#f44336'}` }}
              >
                {toast.msg}
              </Alert>
            </Snackbar>
          </ThemeProvider>
        );
      }

      ReactDOM.createRoot(document.getElementById('root')).render(<AccountPage />);
    </script>
  </body>
</html>
