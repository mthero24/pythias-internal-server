<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8" />
    <title>Pythias — Sign In</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <script src="https://unpkg.com/react@18.2.0/umd/react.production.min.js" crossorigin></script>
    <script src="https://unpkg.com/react-dom@18.2.0/umd/react-dom.production.min.js" crossorigin></script>
    <script src="https://unpkg.com/@emotion/react@11.11.4/dist/emotion-react.umd.min.js" crossorigin></script>
    <script src="https://unpkg.com/@emotion/styled@11.11.0/dist/emotion-styled.umd.min.js" crossorigin></script>
    <script src="https://unpkg.com/@mui/material@5.15.12/umd/material-ui.production.min.js" crossorigin></script>
    <script src="https://unpkg.com/@babel/standalone@7.23.10/babel.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/axios@1.7.9/dist/axios.min.js"></script>
    <style>* { box-sizing: border-box; } body { margin: 0; background: #0d0d0d; }</style>
  </head>
  <body>
    <script>
      window._isRegister = <%- JSON.stringify(register === true) %>;
    </script>
    <div id="root"></div>
    <script type="text/babel">
      const {
        ThemeProvider, createTheme, CssBaseline, Box, Card, CardContent,
        TextField, Button, Typography, Alert, CircularProgress,
      } = MaterialUI;
      const { useState } = React;

      const theme = createTheme({
        palette: {
          mode: 'dark',
          primary: { main: '#fedd94', contrastText: '#1a1a1a' },
          background: { default: '#0d0d0d', paper: '#1a1a1a' },
        },
        typography: { fontFamily: '"Roboto", sans-serif' },
        shape: { borderRadius: 10 },
      });

      function LoginPage() {
        const isRegister = window._isRegister;
        const [username, setUsername] = useState('');
        const [password, setPassword] = useState('');
        const [error, setError] = useState('');
        const [loading, setLoading] = useState(false);

        const handleSubmit = async (e) => {
          if (e && e.preventDefault) e.preventDefault();
          if (!username.trim() || !password.trim()) {
            setError('Username and password are required.');
            return;
          }
          setError('');
          setLoading(true);
          try {
            const endpoint = isRegister ? '/register' : '/login';
            const { data } = await axios.post(endpoint, { userName: username, password });
            if (data.error) {
              setError(data.msg || 'Something went wrong.');
            } else {
              location.href = `/settings?key=${data.key}`;
            }
          } catch {
            setError('Could not connect to server.');
          } finally {
            setLoading(false);
          }
        };

        const handleKeyDown = (e) => {
          if (e.key === 'Enter') handleSubmit();
        };

        return (
          <ThemeProvider theme={theme}>
            <CssBaseline />
            <Box
              sx={{
                minHeight: '100vh',
                display: 'flex',
                alignItems: 'center',
                justifyContent: 'center',
                bgcolor: 'background.default',
                p: 2,
              }}
            >
              <Card sx={{ width: '100%', maxWidth: 420, bgcolor: '#1a1a1a', border: '1px solid #2a2a2a' }}>
                <CardContent sx={{ p: 4 }}>
                  {/* Logo */}
                  <Box sx={{ textAlign: 'center', mb: 3 }}>
                    <img src="/logoPythias-400.png" alt="Pythias" height="60" />
                  </Box>

                  <Typography variant="h5" sx={{ fontWeight: 700, color: '#f0f0f0', mb: 0.5 }}>
                    {isRegister ? 'Create Account' : 'Sign In'}
                  </Typography>
                  <Typography variant="body2" sx={{ color: '#666', mb: 3 }}>
                    {isRegister
                      ? 'Set up your Pythias internal server account.'
                      : 'Sign in to manage your print infrastructure.'}
                  </Typography>

                  {error && (
                    <Alert severity="error" sx={{ mb: 2, bgcolor: 'rgba(211,47,47,0.15)', color: '#ef9a9a', border: '1px solid rgba(211,47,47,0.3)' }}>
                      {error}
                    </Alert>
                  )}

                  <Box component="form" onSubmit={handleSubmit} sx={{ display: 'flex', flexDirection: 'column', gap: 2, mb: 1 }}>
                    <TextField
                      label="Username"
                      variant="outlined"
                      fullWidth
                      value={username}
                      onChange={(e) => setUsername(e.target.value)}
                      onKeyDown={handleKeyDown}
                      autoFocus
                      sx={{ '& .MuiOutlinedInput-root': { '&.Mui-focused fieldset': { borderColor: '#fedd94' } }, '& .MuiInputLabel-root.Mui-focused': { color: '#fedd94' } }}
                    />
                    <TextField
                      label="Password"
                      type="password"
                      variant="outlined"
                      fullWidth
                      value={password}
                      onChange={(e) => setPassword(e.target.value)}
                      onKeyDown={handleKeyDown}
                      sx={{ '& .MuiOutlinedInput-root': { '&.Mui-focused fieldset': { borderColor: '#fedd94' } }, '& .MuiInputLabel-root.Mui-focused': { color: '#fedd94' } }}
                    />
                    <Button
                      type="submit"
                      variant="contained"
                      fullWidth
                      size="large"
                      disabled={loading}
                      sx={{
                        mt: 1,
                        bgcolor: '#fedd94',
                        color: '#1a1a1a',
                        fontWeight: 700,
                        '&:hover': { bgcolor: '#f5ca60' },
                        '&:disabled': { bgcolor: '#3a3a3a', color: '#666' },
                      }}
                    >
                      {loading ? <CircularProgress size={22} sx={{ color: '#1a1a1a' }} /> : (isRegister ? 'Create Account' : 'Sign In')}
                    </Button>
                  </Box>
                  <Box sx={{ textAlign: 'center', mt: 1 }}>
                    <Button
                      href="/"
                      sx={{ color: '#555', fontSize: '0.82rem', '&:hover': { color: '#fedd94', bgcolor: 'transparent' } }}
                      startIcon={<i className="fa-solid fa-arrow-left" style={{ fontSize: '0.75rem' }} />}
                    >
                      Back to Dashboard
                    </Button>
                  </Box>
                </CardContent>
              </Card>
            </Box>
          </ThemeProvider>
        );
      }

      ReactDOM.createRoot(document.getElementById('root')).render(<LoginPage />);
    </script>
  </body>
</html>
